# Copy to deploy/.env and adjust. Read by both compose files.

# --- model server (docker-compose.model.yml) ---
MODEL=Hcompany/Holo-3.1-4B
MAX_MODEL_LEN=16384
GPU_UTIL=0.90
# HF_TOKEN=
# HF_HOME=~/.cache/huggingface

# --- agent (docker-compose.agent.yml) ---
# Model endpoint as seen from the agent container (default: vLLM published on the host).
VLM_BASE_URL=http://host.docker.internal:8000/v1
# VLM_API_KEY=
# EXTRAS=local                 # bake the transformers backend into the image
# ADBKEYBOARD=0                # build without the ADBKeyboard APK

# Device: pick one way to reach the phone
# 1. Host adb server (Windows/macOS): on the host run `adb kill-server` then
#    `adb -a nodaemon server start`, and set:
# ADB_SERVER_SOCKET=tcp:host.docker.internal:5037
# 2. Wi-Fi (wireless debugging):
# ADB_CONNECT=192.168.1.20:5555
# 3. USB inside the container (Linux hosts): leave both unset.
# DEVICE_SERIAL=R58M123ABC     # when several devices are attached
ADB_WAIT_FOR_DEVICE=1
ADB_WAIT_TIMEOUT=30
INSTALL_ADBKEYBOARD=0          # 1 = install + enable ADBKeyboard on the phone if missing

# Secrets referenced by task files
# X_USERNAME=
# X_PASSWORD=
